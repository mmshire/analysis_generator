# Copy this file to .env and fill in your values
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/dalbo_db

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# OTP settings
# In development, any OTP attempt with code "123456" will always succeed.
# In production set this to "false" and plug in your SMS provider below.
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=10

# Firebase (add later for push notifications)
# FIREBASE_SERVER_KEY=
